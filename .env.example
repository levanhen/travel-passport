# Copy the relevant section into each file:
#   apps/api/.env  ·  apps/web/.env.local  ·  packages/db/.env

# ─── apps/api/.env ───────────────────────────────────────────
DATABASE_URL=postgresql://tp:tp@localhost:5432/travel_passport
REDIS_URL=redis://localhost:6379
# Use long random values in any non-local environment (e.g. `openssl rand -base64 48`)
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
LEGAL_POLICY_VERSION=2026-09-01
PORT=3001
CORS_ORIGIN=http://localhost:3000
# PILOT_DESTINATION_SLUG=da-nang
# CHECKIN_QR_TTL_SECONDS=60
# CHECKIN_UPGRADE_WINDOW_MINUTES=30
# UPLOAD_DIR=./uploads/checkin
# Demo only: never enable in production
# CHECKIN_SKIP_GEOFENCE=true

# ─── apps/web/.env.local ─────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_LEGAL_POLICY_VERSION=2026-09-01
# NEXT_PUBLIC_PILOT_DESTINATION_SLUG=da-nang
# Demo only: never enable in production
# NEXT_PUBLIC_DEMO_SKIP_GEOFENCE=true

# ─── packages/db/.env ────────────────────────────────────────
# DATABASE_URL=postgresql://tp:tp@localhost:5432/travel_passport
# Optional seed overrides
# PLATFORM_ADMIN_EMAIL=admin@example.com
# PLATFORM_ADMIN_PASSWORD=
# AUTHORITY_ADMIN_EMAIL=authority@travelpassport.local
# AUTHORITY_ADMIN_PASSWORD=123authority
# SITE_OPERATOR_PASSWORD=123operator
# MERCHANT_OWNER_PASSWORD=123merchant
# MERCHANT_STAFF_PASSWORD=123staff
